---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, u } from '../../data/site';
import { breadcrumbLd, faqLd } from '../../data/seo';

export async function getStaticPaths() {
  const leistungen = await getCollection('leistungen');
  return leistungen.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const artikel = (await getCollection('ratgeber', (p) => !p.data.draft && p.data.leistungen.some((l) => l.id === entry.id)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const andere = (await getCollection('leistungen')).filter((l) => l.id !== entry.id).sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const crumbs = [
  { label: 'Start', href: '/' },
  { label: 'Leistungen', href: '/leistungen/' },
  { label: d.kurz, href: `/leistungen/${entry.id}/` },
];
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.description,
  serviceType: d.kurz,
  provider: { '@id': `${Astro.site}#betrieb` },
  areaServed: site.areas.map((name) => ({ '@type': 'AdministrativeArea', name })),
  url: new URL(`/leistungen/${entry.id}/`, Astro.site).href,
};
const ld = [serviceLd, breadcrumbLd(crumbs, Astro.site!), ...(d.faq.length ? [faqLd(d.faq)] : [])];
---

<Base title={d.seoTitle} description={d.description} image={d.image} jsonLd={ld}>
  <PageHero title={d.title} lead={d.teaser} crumbs={crumbs}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={u(`/kontakt/?leistung=${entry.id}`)} class="btn-primary"><Icon name="camera" class="h-5 w-5" /> Angebot anfordern</a>
      <a href={site.phoneHref} class="btn-ghost"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
    </div>
  </PageHero>

  <section class="py-14 md:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_320px]">
      <article class="prose-baum">
        <Content />
      </article>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <Image src={d.image} alt={d.imageAlt} widths={[400, 640]} width={640} sizes="(min-width: 1024px) 320px, 100vw" class="aspect-[4/5] w-full rounded-2xl object-cover shadow-md" />
        <div class="card p-6">
          <h2 class="text-xl">Kostenlose Einschätzung</h2>
          <p class="mt-2 text-sm text-tinte/75">Schicken Sie mir Fotos Ihres Baumes – ich melde mich in der Regel innerhalb von 24 Stunden.</p>
          <a href={u(`/kontakt/?leistung=${entry.id}`)} class="btn-primary mt-4 w-full !py-2.5 text-sm">Anfrage mit Foto</a>
          <a href={site.phoneHref} class="mt-3 flex items-center justify-center gap-2 text-sm font-semibold text-wald-700"><Icon name="phone" class="h-4 w-4" /> {site.phone}</a>
        </div>
      </aside>
    </div>
  </section>

  {
    d.faq.length > 0 && (
      <section class="bg-white py-14 md:py-20">
        <div class="container-page max-w-3xl">
          <p class="eyebrow">Häufige Fragen</p>
          <h2 class="mt-2 text-3xl">Fragen zu {d.kurz}</h2>
          <div class="mt-8">
            <Faq items={d.faq} />
          </div>
        </div>
      </section>
    )
  }

  {
    artikel.length > 0 && (
      <section class="py-14 md:py-20">
        <div class="container-page">
          <h2 class="text-3xl">Passende Ratgeber-Artikel</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {artikel.map((p) => <ArticleCard post={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-white py-14 md:py-20">
    <div class="container-page">
      <h2 class="text-3xl">Weitere Leistungen</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {andere.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
