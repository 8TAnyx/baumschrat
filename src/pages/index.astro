---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceGroups from '../components/ServiceGroups.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, u } from '../data/site';
import { faqAllgemein } from '../data/faq';
import { faqLd } from '../data/seo';
import heroImg from '../assets/fotos/work-9.jpg';
import aboutImg from '../assets/fotos/work-7.jpg';
import etwLogo from '../assets/site/etw-logo.svg';

const artikel = (await getCollection('ratgeber', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const faq = faqAllgemein.slice(0, 5);

---

<Base
  title="Baumpflege & Baumfällung Graz – ÖNORM L 1122 | Baumschrat"
  description={site.description}
  image={heroImg}
  jsonLd={faqLd(faq)}
>
  <!-- Hero: ganze Breite, Foto mit Schloss Eggenberg im Hintergrund -->
  <section class="relative isolate overflow-hidden bg-wald-950">
    <Image
      src={heroImg}
      alt="Daniel Lindner mit Helm und Seil in einer Baumkrone, im Hintergrund Schloss Eggenberg"
      widths={[800, 1280, 1920, 2560]} width={2560}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[55%_65%]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 -z-10 bg-wald-950/70 lg:bg-transparent lg:bg-gradient-to-r lg:from-wald-950/85 lg:from-25% lg:via-wald-950/35 lg:via-50% lg:to-transparent lg:to-70%"></div>
    <div class="container-page py-16 md:py-24 lg:py-32">
      <div class="max-w-2xl [text-shadow:0_1px_12px_rgb(0_0_0/0.45)]">
        <p class="eyebrow !text-moos-400">Baumpflege · Baumkontrolle · Sonderfällungen</p>
        <h1 class="mt-4 text-4xl leading-[1.08] text-white sm:text-5xl lg:text-6xl">
          Baumpflege aus Graz – im Einsatz in der ganzen Steiermark.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-wald-100 md:text-xl">
          Fachgerechte Baumpflege nach ÖNORM L 1122, Baumkontrolle, Drohnen-Baumprüfung und sichere Fällungen mit Seilklettertechnik – persönlich ausgeführt.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={u('/kontakt/')} class="btn-primary"><Icon name="camera" class="h-5 w-5" /> Kostenloses Angebot</a>
          <a href={site.phoneHref} class="btn-ghost"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
        </div>
        <ul class="mt-8 grid gap-2 text-sm text-wald-100 sm:grid-cols-3">
          <li class="flex items-center gap-2"><Icon name="check-circle" class="h-5 w-5 text-moos-400" /> Arbeit nach ÖNORM</li>
          <li class="flex items-center gap-2"><Icon name="check-circle" class="h-5 w-5 text-moos-400" /> Besichtigung gratis</li>
          <li class="flex items-center gap-2"><Icon name="check-circle" class="h-5 w-5 text-moos-400" /> Antwort in 24 h</li>
        </ul>
        <div class="mt-8 flex items-center gap-3">
          <Image src={etwLogo} alt="Logo European Tree Worker (EAC)" width={64} height={64} class="h-16 w-16" />
          <span class="text-sm leading-tight text-wald-100"><strong class="block text-white">Zertifizierter European Tree Worker</strong>Europäisches Zertifikat für Baumpfleger</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="py-16 md:py-24" id="leistungen">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Leistungen</p>
        <h2 class="mt-2 text-3xl md:text-4xl">Alles rund um Ihre Bäume – aus einer Hand</h2>
        <p class="mt-4 text-lg text-tinte/75">
          Von der Pflege über die Kontrolle bis zur Fällung. Was ich nicht selbst mache, deckt mein Netzwerk aus erfahrenen Partnerbetrieben ab.
        </p>
      </div>
      <div class="mt-10">
        <ServiceGroups />
      </div>
    </div>
  </section>

  <!-- Borkenkäfer-Schwerpunkt -->
  <section class="bg-moos-100">
    <div class="container-page grid items-center gap-8 py-14 md:grid-cols-[auto_1fr_auto]">
      <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-wald-800 text-white"><Icon name="bug" class="h-8 w-8" /></span>
      <div>
        <p class="eyebrow">Aktuell</p>
        <h2 class="mt-1 text-2xl md:text-3xl">Borkenkäfer 2026: Fichten jetzt kontrollieren</h2>
        <p class="mt-2 max-w-2xl text-tinte/80">
          Rund 500.000 Festmeter Schadholz in der Steiermark. Befallene Bäume sollten über den Winter weg. Ordnet die Forstbehörde die Fällung an, ist keine Ersatzpflanzung nötig.
        </p>
      </div>
      <div class="flex flex-col gap-2 text-sm font-semibold">
        <a href={u('/ratgeber/borkenkaefer-2026-graz-steiermark/')} class="inline-flex items-center gap-1 text-wald-800 hover:text-rinde-600">Lage 2026 <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href={u('/ratgeber/borkenkaeferbefall-erkennen/')} class="inline-flex items-center gap-1 text-wald-800 hover:text-rinde-600">Befall erkennen <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href={u('/ratgeber/borkenkaefer-meldung-ersatzpflanzung-graz/')} class="inline-flex items-center gap-1 text-wald-800 hover:text-rinde-600">Behörde &amp; Ersatzpflanzung <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <!-- Über mich -->
  <section class="py-16 md:py-24" id="ueber-mich">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div class="order-last lg:order-first">
        <Image src={aboutImg} alt="Daniel Lindner im Wipfel eines Baumes mit Blick über das Grazer Umland" widths={[480, 800]} width={800} sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[4/5] w-full rounded-3xl object-cover object-[20%_50%] shadow-lg sm:aspect-[4/3] lg:aspect-[4/5]" />
      </div>
      <div>
        <p class="eyebrow">Über mich</p>
        <h2 class="mt-2 text-3xl md:text-4xl">Ein Ansprechpartner – vom ersten Anruf bis zum letzten Ast</h2>
        <div class="mt-5 space-y-4 text-lg text-tinte/80">
          <p>
            Als zertifizierter <strong>European Tree Worker (ETW)</strong> und Einmann-Betrieb stehe ich persönlich für Qualität, Zuverlässigkeit und fachgerechte Ausführung – ob es darum geht, einen Baum zu fällen oder ihn durch fachkundige Pflege zu erhalten. Durch meine Ausbildung und die enge Vernetzung mit erfahrenen Kollegen kann ich Ihnen Lösungen für alle Baumarbeiten anbieten.
          </p>
          <p>
            Ich bin in Graz, in Graz-Umgebung und in der ganzen übrigen Steiermark für Sie im Einsatz. Dabei lege ich besonderen Wert auf Sicherheit, Baumschutz und ehrliche Beratung.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-wald-100">
          <Image src={etwLogo} alt="Logo European Tree Worker (EAC)" width={72} height={72} class="h-18 w-18 shrink-0" />
          <p class="text-sm text-tinte/75"><strong class="block text-base text-wald-900">European Tree Worker (ETW)</strong>Zertifiziert nach den Standards des European Arboricultural Council (EAC) – für fachgerechte, sichere Arbeit an und in Bäumen.</p>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            [
              ['users', 'Persönlicher Service', 'Direkter Kontakt zum Ausführenden'],
              ['check-circle', 'Kostenlose Beratung', 'Unverbindliche Besichtigung und Angebot'],
              ['map-pin', 'Regionale Nähe', 'Kurze Wege, schnelle Reaktion'],
              ['shield-check', 'Faire Preise', 'Transparente Kostenaufstellung'],
            ].map(([icon, title, text]) => (
              <li class="flex gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-wald-50 text-wald-700"><Icon name={icon} class="h-5 w-5" /></span>
                <span><strong class="block text-wald-900">{title}</strong><span class="text-sm text-tinte/70">{text}</span></span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Ratgeber -->
  <section class="bg-white py-16 md:py-24">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Ratgeber</p>
          <h2 class="mt-2 text-3xl md:text-4xl">Wissen rund um Ihre Bäume</h2>
        </div>
        <a href={u('/ratgeber/')} class="inline-flex items-center gap-1 font-semibold text-wald-700 hover:text-rinde-600">Alle Artikel <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {artikel.map((p) => <ArticleCard post={p} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Häufige Fragen</p>
        <h2 class="mt-2 text-3xl md:text-4xl">Gut zu wissen</h2>
        <p class="mt-4 text-tinte/75">Ihre Frage ist nicht dabei? Rufen Sie mich einfach an.</p>
        <a href={u('/faq/')} class="mt-6 inline-flex items-center gap-1 font-semibold text-wald-700 hover:text-rinde-600">Alle Fragen &amp; Antworten <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand />
</Base>
