---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site, u } from '../../data/site';
import { breadcrumbLd } from '../../data/seo';

export async function getStaticPaths() {
  const regionen = await getCollection('regionen');
  return regionen.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [
  { label: 'Start', href: '/' },
  { label: 'Einsatzgebiet', href: '/einsatzgebiet/' },
  { label: d.name, href: `/einsatzgebiet/${entry.id}/` },
];
---

<Base title={d.seoTitle} description={d.description} image={d.image} jsonLd={breadcrumbLd(crumbs, Astro.site!)}>
  <PageHero title={d.title} lead={d.teaser} crumbs={crumbs} image={d.image} imageAlt="">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={u('/kontakt/')} class="btn-primary"><Icon name="camera" class="h-5 w-5" /> Anfrage aus {d.name}</a>
      <a href={site.phoneHref} class="btn-ghost"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
    </div>
  </PageHero>
  <section class="py-14 md:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="prose-baum"><Content /></div>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <Image src={d.image} alt={d.imageAlt} widths={[400, 640]} width={640} sizes="(min-width: 1024px) 320px, 100vw" class="aspect-[4/5] w-full rounded-2xl object-cover shadow-md" />
        <div class="card p-6">
          <h2 class="text-lg">Hier bin ich im Einsatz</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {d.orte.map((o) => <li class="rounded-full bg-wald-50 px-3 py-1 text-sm text-wald-800">{o}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <section class="bg-white py-14 md:py-20">
    <div class="container-page">
      <h2 class="text-3xl">Meine Leistungen in {d.name}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {leistungen.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
