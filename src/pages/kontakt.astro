---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { breadcrumbLd } from '../data/seo';

const crumbs = [
  { label: 'Start', href: '/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<Base
  title="Kontakt & kostenloses Angebot | Baumschrat Graz"
  description="Kostenloses Angebot für Baumpflege, Baumkontrolle oder Baumfällung in Graz anfordern – einfach Fotos vom Baum schicken. Antwort in der Regel innerhalb von 24 Stunden."
  jsonLd={breadcrumbLd(crumbs, Astro.site!)}
>
  <PageHero
    title="Kontakt & Angebot"
    lead="Beschreiben Sie kurz Ihr Anliegen und hängen Sie gerne ein paar Fotos an – das spart oft einen Besichtigungstermin."
    eyebrow="Kontakt"
    crumbs={crumbs}
  />
  <section class="py-14 md:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <ContactForm />
      <aside class="space-y-6">
        <div class="card p-6 md:p-8">
          <h2 class="text-2xl">Direkt erreichen</h2>
          <ul class="mt-5 space-y-4">
            <li>
              <a href={site.phoneHref} class="flex items-center gap-3 text-lg font-semibold text-wald-800 hover:text-rinde-600">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-wald-50"><Icon name="phone" class="h-5 w-5" /></span>
                {site.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${site.email}`} class="flex items-center gap-3 font-semibold text-wald-800 hover:text-rinde-600">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-wald-50"><Icon name="mail" class="h-5 w-5" /></span>
                {site.email}
              </a>
            </li>
          </ul>
        </div>
        <div class="rounded-2xl bg-wald-800 p-6 text-wald-100 md:p-8">
          <h2 class="flex items-center gap-2 text-xl text-white"><Icon name="clock" class="h-5 w-5" /> Schnelle Reaktion</h2>
          <p class="mt-3">
            Ich antworte in der Regel innerhalb von 24 Stunden. Bei Sturmschäden oder dringenden Fällen erreichen Sie mich auch außerhalb der üblichen Zeiten telefonisch.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
