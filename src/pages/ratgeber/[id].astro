---
import { Image } from 'astro:assets';
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { breadcrumbLd, formatDate } from '../../data/seo';

export async function getStaticPaths() {
  const artikel = await getCollection('ratgeber', (p) => !p.data.draft);
  return artikel.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const leistungen = await getEntries(d.leistungen);
const weitere = (await getCollection('ratgeber', (p) => !p.data.draft && p.id !== entry.id))
  .sort((a, b) => Number(b.data.thema === d.thema) - Number(a.data.thema === d.thema) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const crumbs = [
  { label: 'Start', href: '/' },
  { label: 'Ratgeber', href: '/ratgeber/' },
  { label: d.title, href: `/ratgeber/${entry.id}/` },
];
const url = new URL(`/ratgeber/${entry.id}/`, Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Person', name: site.owner, url: Astro.site?.href },
  publisher: { '@id': `${Astro.site}#betrieb` },
  mainEntityOfPage: url,
  inLanguage: 'de-AT',
};
---

<Base title={`${d.title} | Baumschrat`} description={d.description} image={d.image} type="article" jsonLd={[articleLd, breadcrumbLd(crumbs, Astro.site!)]}>
  <article>
    <header class="bg-wald-900">
      <div class="container-page max-w-4xl py-12 md:py-16">
        <Breadcrumbs crumbs={crumbs.slice(0, 2)} light />
        <p class="eyebrow mt-6 !text-moos-400">{d.thema}</p>
        <h1 class="mt-3 text-3xl leading-tight text-white md:text-5xl">{d.title}</h1>
        <p class="mt-5 text-lg text-wald-100">{d.description}</p>
        <p class="mt-6 text-sm text-wald-200">
          Von {site.owner} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          {d.updated && <> · aktualisiert am <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}
        </p>
      </div>
    </header>
    <div class="container-page max-w-4xl">
      <Image src={d.image} alt={d.imageAlt} widths={[640, 960, 1400]} width={1400} height={700} fit="cover" quality={70} sizes="(min-width: 896px) 864px, 100vw" class="-mt-1 aspect-[16/8] w-full rounded-b-3xl object-cover" loading="eager" fetchpriority="high" />
    </div>
    <div class="container-page max-w-3xl py-12 md:py-16">
      <div class="prose-baum prose-table:text-base prose-th:bg-wald-50 prose-th:px-3 prose-td:px-3">
        <Content />
      </div>
    </div>
  </article>

  {
    leistungen.length > 0 && (
      <section class="bg-white py-14">
        <div class="container-page">
          <h2 class="text-2xl md:text-3xl">Dabei kann ich helfen</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {leistungen.map((s) => <ServiceCard service={s} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-14">
    <div class="container-page">
      <h2 class="text-2xl md:text-3xl">Weiterlesen</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {weitere.map((p) => <ArticleCard post={p} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
