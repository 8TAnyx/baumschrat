---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, u } from '../data/site';
import ogFallback from '../assets/fotos/work-7.jpg';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image, type = 'website', jsonLd = [], noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: image ?? ogFallback, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
// Auf der Testumgebung (PUBLIC_NOINDEX=true) sollen Suchmaschinen nichts indexieren.
const robotsNoindex = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${Astro.site}#betrieb`,
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  image: ogUrl,
  founder: { '@type': 'Person', name: site.owner },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: site.areas.map((name) => ({ '@type': 'AdministrativeArea', name })),
  sameAs: [site.wkoUrl],
};
const ld = [business, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
---

<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0f3f31" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-white focus:px-4 focus:py-2">
      Zum Inhalt springen
    </a>
    <Header />
    <main id="inhalt" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Fixe Aktionsleiste am Handy -->
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-wald-800 bg-wald-800 md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
      <a href={site.phoneHref} class="flex items-center justify-center gap-2 bg-wald-700 py-3.5 font-semibold text-white">
        <Icon name="phone" class="h-5 w-5" /> Anrufen
      </a>
      <a href={u('/kontakt/')} class="flex items-center justify-center gap-2 bg-rinde-600 py-3.5 font-semibold text-white">
        <Icon name="camera" class="h-5 w-5" /> Anfrage mit Foto
      </a>
    </div>
  </body>
</html>
