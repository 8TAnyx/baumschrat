---
import Icon from './Icon.astro';
import { site, u } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Sie haben einen Baum, der Ihnen Sorgen macht?',
  text = 'Schicken Sie mir ein paar Fotos – oft kann ich schon daraus abschätzen, was zu tun ist. Besichtigung und Angebot sind kostenlos und unverbindlich.',
} = Astro.props;
---

<section class="bg-wald-800">
  <div class="container-page flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl text-white md:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-wald-100">{text}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href={u('/kontakt/')} class="btn-primary"><Icon name="camera" class="h-5 w-5" /> Anfrage mit Foto</a>
      <a href={site.phoneHref} class="btn-ghost"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
    </div>
  </div>
</section>
