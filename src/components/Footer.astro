---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import logo from '../assets/site/logo.png';
import { site, u } from '../data/site';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-wald-950 pb-20 text-wald-100 md:pb-0">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <a href={u('/')} class="flex items-center gap-2.5">
        <Image src={logo} alt="" width={40} height={50} class="h-10 w-auto brightness-0 invert" />
        <span class="font-display text-xl font-semibold text-white">Baumschrat</span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-wald-200">
        Baumpflege, Baumkontrolle und Spezialfällungen – persönlich ausgeführt von {site.owner}.
      </p>
      <ul class="mt-5 space-y-2 text-sm">
        <li>
          <a href={site.phoneHref} class="inline-flex items-center gap-2 hover:text-white"><Icon name="phone" class="h-4 w-4" />{site.phone}</a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-white"><Icon name="mail" class="h-4 w-4" />{site.email}</a>
        </li>
        <li class="inline-flex items-center gap-2"><Icon name="map-pin" class="h-4 w-4" />{site.street}, {site.zip} {site.city}</li>
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-semibold uppercase tracking-widest text-white">Leistungen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {leistungen.map((l) => <li><a href={u(`/leistungen/${l.id}/`)} class="hover:text-white">{l.data.kurz}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-semibold uppercase tracking-widest text-white">Infos</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={u('/ratgeber/')} class="hover:text-white">Ratgeber</a></li>
        <li><a href={u('/galerie/')} class="hover:text-white">Galerie</a></li>
        <li><a href={u('/faq/')} class="hover:text-white">Häufige Fragen</a></li>
        <li><a href={u('/kontakt/')} class="hover:text-white">Kontakt</a></li>
        <li><a href={u('/impressum/')} class="hover:text-white">Impressum</a></li>
        <li><a href={u('/datenschutz/')} class="hover:text-white">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-wald-800">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-wald-300 sm:flex-row sm:justify-between">
      <p>© {year} {site.owner} · Baumschrat</p>
      <p>Diese Website verwendet keine Cookies und kein Tracking.</p>
    </div>
  </div>
</footer>
